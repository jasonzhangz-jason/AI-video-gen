# LLM（必填，用于提炼环节）
DEEPSEEK_API_KEY=

# 可选：换 provider / 模型
# V2I_PROVIDER=deepseek          # deepseek | openai | moonshot | siliconflow | ollama
# V2I_MODEL=deepseek-chat
# V2I_BASE_URL=https://api.deepseek.com/v1

# ASR（可选）
# V2I_ASR_MODEL=small            # tiny | base | small | medium | large-v3 | turbo
# V2I_ASR_DEVICE=auto            # auto | cpu | cuda
# V2I_ASR_COMPUTE=int8
# V2I_LANGUAGE=zh

# 网络（国内建议开）
# V2I_COOKIES=C:\path\to\cookies.txt
# V2I_PROXY=http://127.0.0.1:7890
# HF_ENDPOINT=https://hf-mirror.com
