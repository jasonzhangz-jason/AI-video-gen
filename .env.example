# LLM（必填，用于提炼环节）
DEEPSEEK_API_KEY=

# 可选：换 provider / 模型
# V2I_PROVIDER=deepseek          # deepseek | openai | moonshot | siliconflow | ollama
# V2I_MODEL=deepseek-chat
# V2I_BASE_URL=https://api.deepseek.com/v1

# ASR（可选）
# V2I_ASR_MODEL=small            # tiny | base | small | medium | large-v3 | turbo
# V2I_ASR_DEVICE=auto            # auto | cpu | cuda
# V2I_ASR_COMPUTE=int8
# V2I_LANGUAGE=zh

# 网络（国内建议开）
# V2I_COOKIES=C:\path\to\cookies.txt
# V2I_PROXY=http://127.0.0.1:7890
# HF_ENDPOINT=https://hf-mirror.com
# 抓取与产物（可选）
# V2I_KEEP_VIDEO=1               # 保留原视频（界面里可播放）
# V2I_EXTRACT_AUDIO=1            # 拿到视频时顺带抽出 audio.m4a
# V2I_DOUYIN_DOWNLOADER=auto     # auto | browser | f2 | douyin-downloader | custom
# V2I_DOUYIN_CMD=                # 自定义下载器命令（用 {url} {dir} 占位）
# V2I_F2_PATH=/path/to/f2        # 指定 f2 可执行文件
# V2I_DOUYIN_DOWNLOADER_PATH=/path/to/run.py

# 人声/伴奏分离（可选，需要先装 audio-separator，约 1GB）
# V2I_SEPARATE=1                 # 开启分离
# V2I_SEPARATE_PROBE=1           # 分离前先试分 45 秒（0 = 直接跑全片）

# 服务（部署脚本会传，也可以写这里）
# V2I_HOST=0.0.0.0
# V2I_PORT=8765
